{
  "name": "dulce-colonial",
  "private": true,
  "scripts": {
    "prisma:generate": "cd backend_dulce_colonial && npm run prisma:generate",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend_dulce_colonial && npm run build",
    "build:frontend": "cd frontend_dulce_colonial && npm run build",
    "dev:backend": "cd backend_dulce_colonial && npm run start:dev",
    "dev:frontend": "cd frontend_dulce_colonial && npm run dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  }
}
